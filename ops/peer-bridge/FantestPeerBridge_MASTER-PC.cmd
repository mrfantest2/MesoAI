@echo off
setlocal EnableExtensions DisableDelayedExpansion
title Fantest Peer Bridge - MASTER-PC
set "FPB_SELF=%~f0"
set "FPB_"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$b=[Convert]::FromBase64String($env:FPB_PAYLOAD);$ms=New-Object IO.MemoryStream(,$b);$gz=New-Object IO.Compression.GZipStream($ms,[IO.Compression.CompressionMode]::Decompress);$sr=New-Object IO.StreamReader($gz,[Text.Encoding]::UTF8);$s=$sr.ReadToEnd();$sr.Dispose();$gz.Dispose();$ms.Dispose();$t=Join-Path $env:TEMP ('FPB_'+[guid]::NewGuid().ToString('N')+'.ps1');[IO.File]::WriteAllText($t,$s,(New-Object Text.UTF8Encoding($false)));try{& $t}finally{Remove-Item -LiteralPath $t -Force -ErrorAction SilentlyContinue}"
exit /b %ERRORLEVEL%
